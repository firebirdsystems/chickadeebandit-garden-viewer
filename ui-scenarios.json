{
  "scenarios": [
    {
      "name": "the view tabs switch between the plant list and the plan, and search narrows the list",
      "members": {
        "member": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_garden_viewer__gardens (id, name, garden_type, created_at, updated_at) VALUES (?, ?, 'image', datetime('now'), datetime('now'))",
          "params": [
            "ui-garden",
            "Back Yard"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_garden_viewer__plants (id, garden_id, common_name, scientific_name, created_at, updated_at) VALUES (?, ?, ?, ?, datetime('now'), datetime('now'))",
          "params": [
            "ui-plant-1",
            "ui-garden",
            "Tomato",
            "Solanum lycopersicum"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_garden_viewer__plants (id, garden_id, common_name, scientific_name, created_at, updated_at) VALUES (?, ?, ?, ?, datetime('now'), datetime('now'))",
          "params": [
            "ui-plant-2",
            "ui-garden",
            "Basil",
            "Ocimum basilicum"
          ]
        },
        {
          "action": "open"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"plant-item\"][data-id=\"ui-plant-1\"]"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"plant-item\"]",
          "count": 2
        },
        {
          "action": "expectText",
          "text": "Tomato",
          "selector": "[data-testid=\"plant-list\"]"
        },
        {
          "action": "expectText",
          "text": "Basil",
          "selector": "[data-testid=\"plant-list\"]"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"view-map\"]"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"floorplan-view\"]"
        },
        {
          "action": "expectText",
          "text": "No floor plan",
          "selector": "[data-testid=\"floorplan-view\"]"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"view-list\"]"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"plant-item\"][data-id=\"ui-plant-1\"]"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"plant-item\"]",
          "count": 2
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"search-input\"]",
          "value": "Basil"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"plant-item\"]",
          "count": 1
        },
        {
          "action": "expectText",
          "text": "Basil",
          "selector": "[data-testid=\"plant-list\"]"
        },
        {
          "action": "expectNoText",
          "text": "Tomato",
          "selector": "[data-testid=\"plant-list\"]"
        }
      ]
    },
    {
      "name": "a child sees every plant but is offered no way to add one",
      "members": {
        "parent": "adult",
        "kid": "child"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_garden_viewer__gardens (id, name, garden_type, created_at, updated_at) VALUES (?, ?, 'image', datetime('now'), datetime('now'))",
          "params": [
            "ui-garden",
            "Back Yard"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_garden_viewer__plants (id, garden_id, common_name, scientific_name, created_at, updated_at) VALUES (?, ?, ?, ?, datetime('now'), datetime('now'))",
          "params": [
            "ui-plant-1",
            "ui-garden",
            "Tomato",
            "Solanum lycopersicum"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_garden_viewer__plants (id, garden_id, common_name, scientific_name, created_at, updated_at) VALUES (?, ?, ?, ?, datetime('now'), datetime('now'))",
          "params": [
            "ui-plant-2",
            "ui-garden",
            "Basil",
            "Ocimum basilicum"
          ]
        },
        {
          "action": "open",
          "as": "parent"
        },
        {
          "action": "waitFor",
          "as": "parent",
          "selector": "[data-testid=\"plant-item\"][data-id=\"ui-plant-1\"]"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"add-plant\"]"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"new-garden\"]"
        },
        {
          "action": "open",
          "as": "kid"
        },
        {
          "action": "waitFor",
          "as": "kid",
          "selector": "[data-testid=\"plant-item\"][data-id=\"ui-plant-1\"]"
        },
        {
          "action": "expectCount",
          "as": "kid",
          "selector": "[data-testid=\"plant-item\"]",
          "count": 2
        },
        {
          "action": "expectText",
          "as": "kid",
          "text": "Tomato",
          "selector": "[data-testid=\"plant-list\"]"
        },
        {
          "action": "expectHidden",
          "as": "kid",
          "selector": "[data-testid=\"add-plant\"]"
        },
        {
          "action": "expectHidden",
          "as": "kid",
          "selector": "[data-testid=\"new-garden\"]"
        }
      ]
    },
    {
      "name": "an adult adds a plant, which is listed under their name after a reload",
      "members": {
        "member": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_garden_viewer__gardens (id, name, garden_type, created_at, updated_at) VALUES (?, ?, 'image', datetime('now'), datetime('now'))",
          "params": [
            "ui-garden-add",
            "Front Yard"
          ]
        },
        {
          "action": "open",
          "as": "member"
        },
        {
          "action": "click",
          "as": "member",
          "selector": "[data-testid=\"add-plant\"]"
        },
        {
          "action": "fill",
          "as": "member",
          "selector": "#plantNameInput",
          "value": "Sword Fern"
        },
        {
          "action": "click",
          "as": "member",
          "selector": "#addPlantSubmitBtn"
        },
        {
          "action": "expectVisible",
          "as": "member",
          "selector": "#placementBanner"
        },
        {
          "action": "click",
          "as": "member",
          "selector": "#placementBanner .btn-skip"
        },
        {
          "action": "click",
          "as": "member",
          "selector": "[data-testid=\"view-list\"]"
        },
        {
          "action": "expectText",
          "as": "member",
          "selector": "[data-testid=\"plant-list\"]",
          "text": "Sword Fern"
        },
        {
          "action": "reload",
          "as": "member"
        },
        {
          "action": "expectCount",
          "as": "member",
          "selector": "[data-testid=\"plant-item\"]",
          "count": 1
        },
        {
          "action": "expectText",
          "as": "member",
          "selector": "[data-testid=\"plant-item\"] .plant-meta",
          "text": "by "
        }
      ]
    }
  ]
}
